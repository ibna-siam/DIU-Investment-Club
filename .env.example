# =========================================================
# DIU INVESTMENT CLUB FINANCIAL MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# ---------------------------------------------------------
# BACKEND CONFIGURATION
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-frontend
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Connection String (Transaction Pooler or Direct URI)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret for fallback session signing / token verification
JWT_SECRET=super-secure-jwt-secret-min-32-chars-diu-invest-club

# Email Provider Configuration (Resend API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="DIU Investment Club <noreply@investmentclub.top>"
EMAIL_MODE=LIVE

# ---------------------------------------------------------
# FRONTEND CONFIGURATION
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="DIU Investment Club Finance"
